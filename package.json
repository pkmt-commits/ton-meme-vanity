{
  "name": "ton-vanity",
  "version": "1.1.0",
  "private": true,
  "description": "GPU (CUDA) and in-browser vanity address generator for TON wallets that finds readable meme phrases, not just a fixed mask",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pkmt-commits/ton-meme-vanity.git"
  },
  "homepage": "https://pkmt-commits.github.io/ton-meme-vanity/",
  "bugs": {
    "url": "https://github.com/pkmt-commits/ton-meme-vanity/issues"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "hunt": "node src/run_cuda.mjs",
    "top": "node scripts/top.mjs",
    "bench": "node scripts/kernel.mjs bench 60 --all-dist 22",
    "selftest": "node ref/selftest.mjs",
    "smoke": "node src/smoke.mjs",
    "telegram-setup": "node src/tg_setup.mjs",
    "calib": "node ref/make_vectors.mjs 20 && node ref/calib.mjs",
    "test": "node --test",
    "build:checker": "node scripts/build-checker.mjs",
    "build:generator": "node scripts/build-generator.mjs"
  },
  "keywords": [
    "ton",
    "toncoin",
    "gram",
    "ton-blockchain",
    "vanity",
    "vanity-address",
    "vanity-address-generator",
    "wallet",
    "telegram",
    "mytonwallet",
    "cuda",
    "gpu",
    "ed25519",
    "w5"
  ],
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.3.0",
    "tweetnacl": "^1.0.3",
    "undici": "^8.11.2"
  }
}
